\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Communication network topology for each tenant. Density $= |E| / (|V|(|V|-1))$ for a directed graph. Reciprocity is the fraction of directed edges that have a reverse edge. Transitivity is the global clustering coefficient. $\gamma $ is the exponent of the power-law fit $P(k) \sim k^{-\gamma }$ to the in-degree complementary cumulative distribution (CCDF), with $R^2$ the goodness-of-fit.}}{21}{table.caption.24}\protected@file@percent }
\newlabel{tab:network_metrics}{{13}{21}{Communication network topology for each tenant. Density $= |E| / (|V|(|V|-1))$ for a directed graph. Reciprocity is the fraction of directed edges that have a reverse edge. Transitivity is the global clustering coefficient. $\gamma $ is the exponent of the power-law fit $P(k) \sim k^{-\gamma }$ to the in-degree complementary cumulative distribution (CCDF), with $R^2$ the goodness-of-fit}{table.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Key communication-network metrics across the three EABench tenants. Density, reciprocity, and transitivity decrease with organizational scale, reflecting the transition from tight-knit professional-services firms to large engineering organizations with departmental silos.}}{21}{figure.caption.25}\protected@file@percent }
\newlabel{fig:network_comparison}{{11}{21}{Key communication-network metrics across the three EABench tenants. Density, reciprocity, and transitivity decrease with organizational scale, reflecting the transition from tight-knit professional-services firms to large engineering organizations with departmental silos}{figure.caption.25}{}}
