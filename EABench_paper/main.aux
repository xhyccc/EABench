\newlabel{tab:tool_usage}{{19}{27}{Mean tool calls per case by agent, aggregated across all three tenants. \emph {Email/Chat/Meeting/File}: content-search endpoints returning ranked snippets. \emph {People}: name-to-ID resolution. \emph {Read}: full-body artifact retrieval (\texttt {read\_file}). \emph {Search-in}: exact-term scan inside an artifact (\texttt {search\_in\_file}). \textsc {Retrieval} is restricted to a single snippet-search call by construction}{table.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \emph  {Left}: stacked tool-call breakdown per configuration (mean calls/case across 525 cases). \textsc  {Researcher} (4o-mini) uses $4\times $ more tools than the reactive configurations, dominated by \texttt  {search\_people} and \texttt  {read\_file}. \textsc  {Retrieval} is restricted to a single snippet-search call. \emph  {Right}: per-tenant pass-rate comparison between snippet-only \textsc  {Retrieval} and two browsing-enabled configurations. Browsing yields a consistent 9--15 point lift on Bertrand and Cambford; on ZAI, \textsc  {ReAct-v1} (4o-mini) gains 15 points while \textsc  {Researcher} (4o-mini) gains only 8.}}{28}{figure.caption.30}\protected@file@percent }
\newlabel{fig:tool_ablation}{{10}{28}{\emph {Left}: stacked tool-call breakdown per configuration (mean calls/case across 525 cases). \textsc {Researcher} (4o-mini) uses $4\times $ more tools than the reactive configurations, dominated by \texttt {search\_people} and \texttt {read\_file}. \textsc {Retrieval} is restricted to a single snippet-search call. \emph {Right}: per-tenant pass-rate comparison between snippet-only \textsc {Retrieval} and two browsing-enabled configurations. Browsing yields a consistent 9--15 point lift on Bertrand and Cambford; on ZAI, \textsc {ReAct-v1} (4o-mini) gains 15 points while \textsc {Researcher} (4o-mini) gains only 8}{figure.caption.30}{}}
